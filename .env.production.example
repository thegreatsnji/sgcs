# SGCS — produção (Hostinger VPS). Copie para .env.production e preencha.
# NUNCA commitar .env.production.

APP_NAME=SGCS
APP_ENV=production
APP_DEBUG=false

# Gere: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

ALLOWED_HOSTS=sgcs.seudominio.com,www.sgcs.seudominio.com

# Mesmo domínio que serve o frontend (HTTPS)
CORS_ALLOWED_ORIGINS=https://sgcs.seudominio.com
CSRF_TRUSTED_ORIGINS=https://sgcs.seudominio.com

# Frontend build: vazio = API no mesmo domínio (/api/v1 via Nginx)
VITE_API_URL=

DB_NAME=sgcs
DB_USER=sgcs
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Redis: separar filas Celery, resultados e cache (menos contenção)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2
USE_REDIS=true
CACHE_TIMEOUT=300
DB_CONN_MAX_AGE=120

# TLS terminado no Nginx / Hostinger
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_HOST=true

# Segurança API
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_API_DOCS=false
DJANGO_ADMIN_PATH=sgcs-admin

THROTTLE_LOGIN=10/minute
THROTTLE_ANON=100/hour
THROTTLE_USER=3000/hour
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=45
JWT_REFRESH_TOKEN_LIFETIME_DAYS=3
PASSWORD_MIN_LENGTH=10

LOG_TO_FILES=true
LOG_JSON=true
LOG_LEVEL=INFO

SGCS_SEED_DEMO=0

HTTP_PORT=80
# HTTPS (após vps-enable-https.sh): caminho Nginx gerado; HTTPS_PORT=443
HTTPS_PORT=
NGINX_CONF_PATH=
# COMPOSE_HTTPS=1  # definido pelo script enable-https (compose-prod.sh detecta NGINX ssl)

# VPS KVM 2 (2 vCPU): 3 workers; formula (2×CPU)+1 se tiver RAM
GUNICORN_WORKERS=3
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
CELERY_CONCURRENCY=2
CELERY_PREFETCH=1
