# SGCS — Variáveis de ambiente (exemplo)
# Copie este ficheiro para .env e ajuste os valores conforme necessário

# Aplicação
APP_NAME=SGCS
APP_ENV=development
APP_DEBUG=true

# Django
SECRET_KEY=altere-esta-chave-secreta-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Base de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgcs
DB_USER=sgcs
DB_PASSWORD=sgcs

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Redis (local dev outside Docker: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis e Cache
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
USE_REDIS=true
CACHE_TIMEOUT=300

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Feature flags
FEATURE_ANALYTICS_ENABLED=false
FEATURE_ASYNC_TASKS_ENABLED=true
FEATURE_FILE_UPLOADS_ENABLED=true
FEATURE_EVENT_BUS_ENABLED=true
FEATURE_CLINICAL_MODULES_ENABLED=false

# Superutilizador de desenvolvimento (comando create_superuser_dev)
SUPERUSER_EMAIL=admin@sauvida.ao
SUPERUSER_PASSWORD=Admin@12345
SUPERUSER_FIRST_NAME=Administrador
SUPERUSER_LAST_NAME=SGCS
